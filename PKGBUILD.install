post_install() {
    echo "==> Nextless: default configuration files are installed under /etc/nextless/."
    echo "==> Pacman will preserve edited /etc/nextless/*.json files on upgrade and may create .pacnew files."
    echo "==> Missing per-user config files are created from /etc/nextless/ at runtime under ~/.config/nextless/."
    printf '\033[1;31m==> Nextless: Local ASR models (zipformer/fire-red) must be downloaded separately.\033[0m\n'
    echo "==> See setup instructions: https://github.com/RevolutionLA/nextless#3-get-models-local-backends"
    echo "==> The push-to-talk key is configurable: fcitx5 配置 -> 插件 -> Nextless -> Hotkey (default Right Ctrl)."
    echo "==> Cloud providers (doubao/qwen) only need API keys configured."
}

post_upgrade() {
    post_install
}
